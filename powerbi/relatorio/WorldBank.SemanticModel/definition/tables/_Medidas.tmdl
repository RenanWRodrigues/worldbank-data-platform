	/// K25 — Substitui o cartão "Lag dos consumidores" (o usuário powerbi não lê ops.kafka_lag).
	measure 'Minutos desde o último evento' =
			VAR _ultimo = [Último evento recebido]
			RETURN
			    IF ( NOT ISBLANK ( _ultimo ), DATEDIFF ( _ultimo, NOW (), MINUTE ) )
		formatString: 0
		displayFolder: 4. Ao vivo
		lineageTag: 5a910328-50a3-4c6f-8b5d-4e20fb13ee21

	/// K25 — Indicador "ao vivo · último evento há N min" do cabeçalho.
	measure 'Status do stream' =
			VAR _min = [Minutos desde o último evento]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _min ), "sem eventos no rt",
			        _min <= 5, "ao vivo · último evento há " & _min & " min",
			        "sem eventos novos há " & _min & " min"
			    )
		displayFolder: 4. Ao vivo
		lineageTag: ded7ce83-f280-4598-bbf5-a4b9cd680e37

	/// K28 — Projetos no estado atual do rt.
	measure 'Projetos no rt' = COUNTROWS ( rt_projects_latest )
		formatString: #,0
		displayFolder: 4. Ao vivo
		lineageTag: 6c5aa7a7-fc05-47c4-a190-fbca9fa4664f

	/// K28
	measure 'Projetos ativos no rt' = CALCULATE ( COUNTROWS ( rt_projects_latest ), rt_projects_latest[status] = "Active" )
		formatString: #,0
		displayFolder: 4. Ao vivo
		lineageTag: c7093c2d-fbf7-47b5-a399-82148360b603

	/// Para a detecção de alterações da atualização de página: muda a cada evento novo.
	measure 'Último seq' = MAX ( rt_project_events[seq] )
		formatString: 0
		displayFolder: 4. Ao vivo
		lineageTag: 165d0361-e4ab-49a2-9d38-ca22b49246a3

	/// Perfil do País: nome do país no contexto (drill-through ou filtro de página).
	measure 'País selecionado' = SELECTEDVALUE ( dim_country[country_name], "Vários países" )
		displayFolder: 1. Visão Global
		lineageTag: 8fa8cb2f-3fa9-4249-9d9e-ae3dcc0395e5

	/// Perfil do País: região do país no contexto.
	measure 'Região selecionada' = SELECTEDVALUE ( dim_country[region], "—" )
		displayFolder: 1. Visão Global
		lineageTag: 64bb41c5-d886-4ac1-8f12-7fa3301b7abf

	/// K13 — Valor comprometido em bilhões de US$, para tabelas (cartões e gráficos usam unidades automáticas).
	measure 'Valor comprometido (US$ bi)' = DIVIDE ( [Valor comprometido (US$)], 1E9 )
		formatString: #,0.0
		displayFolder: 3. Projetos
		lineageTag: 0b8f2016-e34d-462b-89f3-a8bb88eb779c

	column _
		isHidden
		lineageTag: 5d652f6c-b047-4b4a-95d9-fd63eb871d24
		isNameInferred
		sourceColumn: [_]

	partition _Medidas = calculated
		mode: import
		source = ROW ( "_", BLANK () )
