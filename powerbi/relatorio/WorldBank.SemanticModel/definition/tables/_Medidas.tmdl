	/// K22 — Eventos que chegaram ao rt na última hora.
	measure 'Eventos (última hora)' =
			VAR _desde = NOW () - 1 / 24
			RETURN
			    CALCULATE ( COUNTROWS ( rt_project_events ), rt_project_events[consumed_at] >= _desde ) + 0
		formatString: #,0
		displayFolder: 4. Ao vivo
		lineageTag: c63cc476-5db8-49be-bdc0-20b95f881c94

	/// K22
	measure 'Eventos (hora anterior)' =
			VAR _agora = NOW ()
			RETURN
			    CALCULATE (
			        COUNTROWS ( rt_project_events ),
			        rt_project_events[consumed_at] >= _agora - 2 / 24,
			        rt_project_events[consumed_at] < _agora - 1 / 24
			    ) + 0
		formatString: #,0
		displayFolder: 4. Ao vivo
		lineageTag: a9a1d951-bc97-4d25-b12c-2509979f3830

	/// K22
	measure 'Eventos — var. % vs hora anterior' =
			VAR _atual = [Eventos (última hora)]
			VAR _anterior = [Eventos (hora anterior)]
			RETURN
			    IF ( _atual = 0 && _anterior = 0, 0, DIVIDE ( _atual - _anterior, _anterior ) )
		formatString: +0% "vs hora anterior";-0% "vs hora anterior";0% "vs hora anterior"
		displayFolder: 4. Ao vivo
		lineageTag: 1cb42d93-f333-45cc-838d-b3e4687e2669

	/// K26 — Eventos nas últimas 24 h (barras por event_type). Sem "+ 0": ver medidas.dax.
	measure 'Eventos (24h)' =
			VAR _desde = NOW () - 1
			RETURN
			    CALCULATE ( COUNTROWS ( rt_project_events ), rt_project_events[consumed_at] >= _desde )
		formatString: #,0
		displayFolder: 4. Ao vivo
		lineageTag: 46b3e2b5-43f2-454f-92b4-03a919683250

	/// K22 — Aprovações recebidas nas últimas 24 h.
	measure 'Aprovações (24h)' =
			VAR _desde = NOW () - 1
			RETURN
			    CALCULATE (
			        COUNTROWS ( rt_project_events ),
			        KEEPFILTERS ( rt_project_events[event_type] = "PROJECT_APPROVED" ),
			        rt_project_events[consumed_at] >= _desde
			    ) + 0
		formatString: #,0
		displayFolder: 4. Ao vivo
		lineageTag: 223d0efe-cfa8-4b38-b5c4-6144e1188352

	/// K23 — Compromisso atual dos projetos com aprovação recebida nas últimas 24 h. TREATAS em vez de relacionamento: o conector PostgreSQL não dobra junções de texto em DirectQuery.
	measure 'Valor aprovado (24h) (US$)' =
			VAR _desde = NOW () - 1
			VAR _ids =
			    CALCULATETABLE (
			        VALUES ( rt_project_events[project_id] ),
			        KEEPFILTERS ( rt_project_events[event_type] = "PROJECT_APPROVED" ),
			        rt_project_events[consumed_at] >= _desde
			    )
			RETURN
			    CALCULATE ( SUM ( rt_projects_latest[total_commitment_usd] ), TREATAS ( _ids, rt_projects_latest[project_id] ) ) + 0
		formatString: #,0
		displayFolder: 4. Ao vivo
		lineageTag: 6c9dd1f9-5ed6-4e97-896e-045e7c0a0e8a

	/// K23 — Projetos com aprovação recebida nas últimas 24 h (TREATAS, ver Valor aprovado (24h)).
	measure 'Projetos aprovados (24h)' =
			VAR _desde = NOW () - 1
			VAR _ids =
			    CALCULATETABLE (
			        VALUES ( rt_project_events[project_id] ),
			        KEEPFILTERS ( rt_project_events[event_type] = "PROJECT_APPROVED" ),
			        rt_project_events[consumed_at] >= _desde
			    )
			RETURN
			    CALCULATE ( COUNTROWS ( rt_projects_latest ), TREATAS ( _ids, rt_projects_latest[project_id] ) ) + 0
		formatString: #,0
		displayFolder: 4. Ao vivo
		lineageTag: d637e05e-c26a-4d06-bba7-69dd48c05747

	/// K23
	measure 'Valor médio aprovado (24h) (US$)' = DIVIDE ( [Valor aprovado (24h) (US$)], [Projetos aprovados (24h)], 0 )
		formatString: "média US$ "#,0
		displayFolder: 4. Ao vivo
		lineageTag: a57074a6-88dc-49a4-b450-36ae68bcd9d1

	/// K24 — Alertas LARGE_APPROVAL criados nas últimas 24 h.
	measure 'Alertas (24h)' =
			VAR _desde = NOW () - 1
			RETURN
			    CALCULATE ( COUNTROWS ( rt_alerts ), rt_alerts[created_at] >= _desde ) + 0
		formatString: #,0
		displayFolder: 4. Ao vivo
		lineageTag: 3cded788-d5ee-4b63-aa15-d5cea3d7dc25

	/// K25 — Hora em que o último evento chegou ao rt (horário local: o Desktop converte o timestamptz).
	measure 'Último evento recebido' = MAX ( rt_project_events[consumed_at] )
		formatString: dd/mm/yyyy hh:nn:ss
		displayFolder: 4. Ao vivo
