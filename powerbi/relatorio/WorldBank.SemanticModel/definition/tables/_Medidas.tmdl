table _Medidas
	lineageTag: 96951e21-2990-4caa-ba65-efc9a9f267cc

	/// Menor nº de países (não agregados) com valor entre os 4 indicadores, no(s) ano(s) do contexto. Ignora filtros de país/região.
	measure 'Cobertura mínima de países' =
			VAR _pop =
			    CALCULATE (
			        COUNTROWS ( agg_country_year ),
			        NOT ISBLANK ( agg_country_year[population] ),
			        REMOVEFILTERS ( dim_country ),
			        dim_country[is_aggregate] = FALSE ()
			    )
			VAR _pib =
			    CALCULATE (
			        COUNTROWS ( agg_country_year ),
			        NOT ISBLANK ( agg_country_year[gdp_usd] ),
			        REMOVEFILTERS ( dim_country ),
			        dim_country[is_aggregate] = FALSE ()
			    )
			VAR _rural =
			    CALCULATE (
			        COUNTROWS ( agg_country_year ),
			        NOT ISBLANK ( agg_country_year[rural_population_pct] ),
			        REMOVEFILTERS ( dim_country ),
			        dim_country[is_aggregate] = FALSE ()
			    )
			VAR _eletricidade =
			    CALCULATE (
			        COUNTROWS ( agg_country_year ),
			        NOT ISBLANK ( agg_country_year[electricity_access_pct] ),
			        REMOVEFILTERS ( dim_country ),
			        dim_country[is_aggregate] = FALSE ()
			    )
			RETURN
			    MIN ( MIN ( _pop, _pib ), MIN ( _rural, _eletricidade ) )
		formatString: 0
		displayFolder: 0. Ano de referência
		lineageTag: 2c15e1c2-90b7-4425-930a-da045d169f49

	/// K00 — Com um ano no contexto usa esse ano; senão, o último ano em que os 4 indicadores têm ≥ 180 países.
	measure 'Ano de referência' =
			VAR _anosCobertos =
			    FILTER ( VALUES ( dim_year[year] ), [Cobertura mínima de países] >= 180 )
			RETURN
			    IF (
			        HASONEVALUE ( dim_year[year] ),
			        VALUES ( dim_year[year] ),
			        MAXX ( _anosCobertos, dim_year[year] )
			    )
		formatString: 0
		displayFolder: 0. Ano de referência
		lineageTag: c4291126-6ef0-4391-8ed0-628fdee81ca5

	/// Rótulo para títulos/subtítulos dinâmicos ("2024 · Todas as regiões").
	measure 'Rótulo do contexto' =
			VAR _regiao =
			    IF ( ISFILTERED ( dim_country[region] ), SELECTEDVALUE ( dim_country[region], "Várias regiões" ), "Todas as regiões" )
			RETURN
			    [Ano de referência] & " · " & _regiao
		displayFolder: 0. Ano de referência
		lineageTag: debe2733-bc2d-4eb4-bca0-7c3b11330007

	/// Cabeçalho "Atualizado em …": última carga do dw (dw.load_audit).
	measure 'Última carga do DW' = MAX ( load_audit[loaded_at] )
		formatString: dd/mm/yyyy hh:nn
		displayFolder: 0. Ano de referência
		lineageTag: b81909bd-39d9-4144-9643-68baae93d621

	/// K01 — Soma da população dos países no ano de referência.
	measure População =
			VAR _ano = [Ano de referência]
			RETURN
			    CALCULATE (
			        SUM ( agg_country_year[population] ),
			        dim_year[year] = _ano,
			        KEEPFILTERS ( dim_country[is_aggregate] = FALSE () )
			    )
		formatString: #,0
		displayFolder: 1. Visão Global
		lineageTag: 17516230-5749-4222-93b4-0b0795819c79

	/// K02 — Crescimento anual composto da população em 10 anos.
	measure 'População — cresc. a.a. em 10 anos' =
			VAR _ano = [Ano de referência]
			VAR _atual = [População]
			VAR _base = CALCULATE ( [População], dim_year[year] = _ano - 10 )
			RETURN
			    IF ( _base > 0 && _atual > 0, POWER ( DIVIDE ( _atual, _base ), 0.1 ) - 1 )
		formatString: +0.0% "a.a. em 10 anos";-0.0% "a.a. em 10 anos"
		displayFolder: 1. Visão Global
		lineageTag: 751c46d6-e130-435a-9e8e-b6f9bad6abda

	/// K03 — PIB (US$ correntes) somado entre os países com valor no ano.
	measure 'PIB (US$)' =
			VAR _ano = [Ano de referência]
			RETURN
			    CALCULATE (
			        SUM ( agg_country_year[gdp_usd] ),
			        dim_year[year] = _ano,
			        KEEPFILTERS ( dim_country[is_aggregate] = FALSE () )
			    )
		formatString: #,0
		displayFolder: 1. Visão Global
		lineageTag: 1dd24a20-ecc9-4f7e-a1c8-221aa91c14fb

	/// K03 — Variação do PIB frente ao ano anterior.
	measure 'PIB — var. % vs ano anterior' =
			VAR _ano = [Ano de referência]
			VAR _anterior = CALCULATE ( [PIB (US$)], dim_year[year] = _ano - 1 )
			RETURN
			    DIVIDE ( [PIB (US$)] - _anterior, _anterior )
		formatString: +0.0% "vs ano anterior";-0.0% "vs ano anterior"
		displayFolder: 1. Visão Global
		lineageTag: 6188d30e-7666-4f5d-89b8-d624557f8c30

	/// K04 — PIB per capita ponderado = Σ PIB / Σ população, só países com os dois valores no ano.
	measure 'PIB per capita (US$)' =
			VAR _ano = [Ano de referência]
			VAR _pib =
			    CALCULATE (
			        SUM ( agg_country_year[gdp_usd] ),
			        dim_year[year] = _ano,
			        NOT ISBLANK ( agg_country_year[population] ),
			        NOT ISBLANK ( agg_country_year[gdp_usd] ),
			        KEEPFILTERS ( dim_country[is_aggregate] = FALSE () )
			    )
			VAR _pop =
			    CALCULATE (
			        SUM ( agg_country_year[population] ),
			        dim_year[year] = _ano,
			        NOT ISBLANK ( agg_country_year[population] ),
			        NOT ISBLANK ( agg_country_year[gdp_usd] ),
			        KEEPFILTERS ( dim_country[is_aggregate] = FALSE () )
			    )
			RETURN
			    DIVIDE ( _pib, _pop )
		formatString: #,0
		displayFolder: 1. Visão Global
		lineageTag: 7128cf2f-b299-4b95-b8b1-c1daa573df2d

	/// K04 — Variação do PIB per capita frente ao ano anterior.
	measure 'PIB per capita — var. % vs ano anterior' =
			VAR _ano = [Ano de referência]
			VAR _anterior = CALCULATE ( [PIB per capita (US$)], dim_year[year] = _ano - 1 )
			RETURN
			    DIVIDE ( [PIB per capita (US$)] - _anterior, _anterior )
		formatString: +0.0% "vs ano anterior";-0.0% "vs ano anterior"
		displayFolder: 1. Visão Global
		lineageTag: 7081e9f5-4248-4271-99a0-4fcc7fb682f2

	/// K09 — Posição do país no ranking de PIB do ano (1 = maior); em branco sem exatamente um país.
	measure 'Posição no ranking de PIB' =
			VAR _ano = [Ano de referência]
			VAR _pib = [PIB (US$)]
			VAR _todos =
			    CALCULATETABLE (
			        ADDCOLUMNS ( VALUES ( dim_country[country_code] ), "@pib", [PIB (US$)] ),
			        REMOVEFILTERS ( dim_country ),
			        dim_year[year] = _ano
			    )
			RETURN
			    IF (
			        HASONEVALUE ( dim_country[country_code] ) && NOT ISBLANK ( _pib ),
			        COUNTROWS ( FILTER ( _todos, [@pib] > _pib ) ) + 1
			    )
		formatString: 0"º"
		displayFolder: 1. Visão Global
		lineageTag: 1c364c22-a591-4056-9b10-771ade57a765

	/// K05 — Acesso à eletricidade (% da população, 0–100), média ponderada pela população.
	measure 'Acesso à eletricidade (%)' =
			VAR _ano = [Ano de referência]
			VAR _ponderado =
			    CALCULATE (
			        SUMX ( agg_country_year, agg_country_year[population] * agg_country_year[electricity_access_pct] ),
			        dim_year[year] = _ano,
			        NOT ISBLANK ( agg_country_year[population] ),
			        NOT ISBLANK ( agg_country_year[electricity_access_pct] ),
			        KEEPFILTERS ( dim_country[is_aggregate] = FALSE () )
			    )
			VAR _pop =
			    CALCULATE (
			        SUM ( agg_country_year[population] ),
			        dim_year[year] = _ano,
			        NOT ISBLANK ( agg_country_year[population] ),
			        NOT ISBLANK ( agg_country_year[electricity_access_pct] ),
			        KEEPFILTERS ( dim_country[is_aggregate] = FALSE () )
			    )
			RETURN
			    DIVIDE ( _ponderado, _pop )
		formatString: 0.0
		displayFolder: 2. Energia e Desenvolvimento
		lineageTag: 661fcab9-de20-4e1c-8855-9419ac43d5ee

	/// K05 — Diferença em pontos percentuais frente a 10 anos antes.
	measure 'Acesso à eletricidade — var. p.p. em 10 anos' =
			VAR _ano = [Ano de referência]
			VAR _base = CALCULATE ( [Acesso à eletricidade (%)], dim_year[year] = _ano - 10 )
			RETURN
			    IF ( NOT ISBLANK ( _base ), [Acesso à eletricidade (%)] - _base )
		formatString: +0.0" p.p. em 10 anos";-0.0" p.p. em 10 anos"
		displayFolder: 2. Energia e Desenvolvimento
		lineageTag: d78ce285-b60a-4ae6-bb76-7887679bf624

	/// K05 — Variante para o gráfico de halteres por região (2000 → ano de referência).
	measure 'Acesso à eletricidade em 2000 (%)' = CALCULATE ( [Acesso à eletricidade (%)], dim_year[year] = 2000 )
		formatString: 0.0
		displayFolder: 2. Energia e Desenvolvimento
		lineageTag: 8d50b3e8-69e6-4ecc-b65b-f5377fcca7e7

	/// K06 — Σ população × (100 − acesso) / 100.
	measure 'Pessoas sem eletricidade' =
			VAR _ano = [Ano de referência]
			RETURN
			    CALCULATE (
			        SUMX (
			            agg_country_year,
			            agg_country_year[population] * ( 100 - agg_country_year[electricity_access_pct] ) / 100
			        ),
			        dim_year[year] = _ano,
			        NOT ISBLANK ( agg_country_year[population] ),
			        NOT ISBLANK ( agg_country_year[electricity_access_pct] ),
			        KEEPFILTERS ( dim_country[is_aggregate] = FALSE () )
			    )
		formatString: #,0
		displayFolder: 2. Energia e Desenvolvimento
		lineageTag: 55d0ea15-0826-4ca7-b8f1-410da31bf393

	/// K06 — Variação absoluta em 10 anos (negativo = menos gente sem luz).
	measure 'Pessoas sem eletricidade — var. em 10 anos' =
			VAR _ano = [Ano de referência]
			VAR _base = CALCULATE ( [Pessoas sem eletricidade], dim_year[year] = _ano - 10 )
			RETURN
			    IF ( NOT ISBLANK ( _base ), [Pessoas sem eletricidade] - _base )
		formatString: +#,0;-#,0
		displayFolder: 2. Energia e Desenvolvimento
		lineageTag: 9feceeca-e92d-4122-8826-2d308f3d8bef

	/// K07 — População rural (% do total, 0–100), média ponderada pela população.
	measure 'População rural (%)' =
			VAR _ano = [Ano de referência]
			VAR _ponderado =
			    CALCULATE (
			        SUMX ( agg_country_year, agg_country_year[population] * agg_country_year[rural_population_pct] ),
			        dim_year[year] = _ano,
			        NOT ISBLANK ( agg_country_year[population] ),
			        NOT ISBLANK ( agg_country_year[rural_population_pct] ),
			        KEEPFILTERS ( dim_country[is_aggregate] = FALSE () )
			    )
			VAR _pop =
			    CALCULATE (
			        SUM ( agg_country_year[population] ),
			        dim_year[year] = _ano,
			        NOT ISBLANK ( agg_country_year[population] ),
			        NOT ISBLANK ( agg_country_year[rural_population_pct] ),
			        KEEPFILTERS ( dim_country[is_aggregate] = FALSE () )
			    )
			RETURN
			    DIVIDE ( _ponderado, _pop )
		formatString: 0.0
		displayFolder: 2. Energia e Desenvolvimento
		lineageTag: 45f69914-881e-4ba0-9b68-dbbb06eed618

	/// K07 — Diferença em pontos percentuais frente a 10 anos antes.
	measure 'População rural — var. p.p. em 10 anos' =
			VAR _ano = [Ano de referência]
			VAR _base = CALCULATE ( [População rural (%)], dim_year[year] = _ano - 10 )
			RETURN
			    IF ( NOT ISBLANK ( _base ), [População rural (%)] - _base )
		formatString: +0.0" p.p. em 10 anos";-0.0" p.p. em 10 anos"
		displayFolder: 2. Energia e Desenvolvimento
		lineageTag: c67122fc-8ca5-4dfd-913e-ce8a13da333c

	/// K08 — Países com ≥ 99,5% da população com eletricidade no ano.
	measure 'Países com acesso universal' =
			VAR _ano = [Ano de referência]
			RETURN
			    CALCULATE (
			        COUNTROWS ( agg_country_year ),
			        dim_year[year] = _ano,
			        agg_country_year[electricity_access_pct] >= 99.5,
			        KEEPFILTERS ( dim_country[is_aggregate] = FALSE () )
			    )
