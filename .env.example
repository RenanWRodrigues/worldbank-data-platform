# Copie para .env e ajuste:  cp .env.example .env

# ---------- PostgreSQL (DW, tempo real, controle e metadados do Airflow)
POSTGRES_USER=wb
POSTGRES_PASSWORD=wb_password
# mantenha "worldbank" (nome usado em postgres/init/01_init.sql)
POSTGRES_DB=worldbank
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Porta publicada no host (psql, Power BI, testes de integração); use 5433 se já houver um Postgres local na 5432
POSTGRES_HOST_PORT=5432
# Usuários somente leitura criados por postgres/init/00_users.sh (troque as senhas)
POWERBI_PASSWORD=troque-powerbi
API_RO_PASSWORD=troque-api-ro

# ---------- Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# A DAG de micro-lotes falha se algum consumer group passar deste lag
KAFKA_MAX_LAG=20000
# Heap da JVM do broker (a stack inteira precisa caber em 8 GB)
KAFKA_HEAP_OPTS=-Xmx512m -Xms512m

# ---------- Producer de eventos de projetos
# replay = histórico do Kaggle em ordem cronológica (demonstração)
# live   = consulta a Projects API do World Bank e publica só o que mudou
PRODUCER_MODE=replay
RAW_DATA_DIR=/data/raw
REPLAY_START=2000-01-01
# 30 dias simulados por segundo: 2000→2018 em ~4 minutos
REPLAY_DAYS_PER_SECOND=30
POLL_MINUTES=15
# A Projects API publica aprovações com atraso (em out/2026 a mais recente era de dez/2024)
LIVE_LOOKBACK_DAYS=730

# ---------- Consumidores
# lake-sink fecha um micro-lote a cada N eventos ou T segundos
FLUSH_MAX_EVENTS=500
FLUSH_MAX_SECONDS=60
# realtime-sink: alerta para aprovações a partir deste valor (US$)
ALERT_MIN_COMMITMENT_USD=500000000
# realtime-sink: mensagens por transação no rt
RT_BATCH=500
# data_quality do micro-lote: projeto que chegou ao rt há mais que isso precisa existir no dw
RT_DW_MAX_DELAY_MINUTES=60

# ---------- API do World Bank (fonte dos indicadores)
# Lista de indicadores extraídos toda semana (vazio = padrão: população, PIB, % rural, % eletricidade)
WB_INDICATORS=

# ---------- FastAPI (serving)
# Se definido, exige o header X-API-Key nas rotas /v1
API_KEY=
CORS_ORIGINS=*

# ---------- Databricks (Free Edition ou workspace pago)
# Host sem barra final, ex.: https://dbc-1234abcd-5678.cloud.databricks.com
DATABRICKS_HOST=
# Personal Access Token (User Settings > Developer > Access tokens)
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=worldbank
DATABRICKS_SCHEMA=lakehouse
DATABRICKS_VOLUME=landing
# SQL Warehouse usado para copiar o gold para o PostgreSQL (Connection details > HTTP path)
DATABRICKS_HTTP_PATH=
# IDs dos jobs criados pelo bundle (databricks jobs list | grep worldbank)
DATABRICKS_JOB_ID_INDICATORS=
DATABRICKS_JOB_ID_PROJECTS=

# ---------- Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Qualquer string longa e aleatória (ex.: openssl rand -hex 32)
AIRFLOW_JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
